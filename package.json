{
  "name": "farmdirect",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan,green\" \"node server.js\" \"vite --host 127.0.0.1 --port 5173\"",
    "server": "node server.js",
    "build": "tsc -b && vite build",
